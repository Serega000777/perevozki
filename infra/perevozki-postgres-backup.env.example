# Install separately at /etc/perevozki-postgres-backup.conf (mode 0600).
# Local backups are outside the database Docker volume and project checkout.
BACKUP_DIR=/var/backups/perevozki/postgresql
BACKUP_RETENTION_DAYS=14
# For a dedicated mounted backup disk, fail closed if it is not mounted:
# BACKUP_REQUIRE_MOUNTPOINT=/mnt/perevozki-backup
