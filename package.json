{
  "name": "perevozki",
  "private": true,
  "workspaces": [
    "backend",
    "frontend",
    "bot"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c green,cyan \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "dev:bot": "npm run dev -w bot",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm test -w backend",
    "test:e2e": "npm run test:e2e -w backend",
    "db:generate": "npm run db:generate -w backend",
    "db:migrate": "npm run db:migrate -w backend",
    "dev:init-data": "node scripts/dev-init-data.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "dotenv-cli": "^8.0.0",
    "prettier": "^3.5.3"
  }
}
