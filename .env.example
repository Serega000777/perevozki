# Perevozki — пример окружения.
# Скопируйте в .env и заполните. Файл .env в git НЕ коммитится (репозиторий публичный!).

# ---------- PostgreSQL ----------
POSTGRES_USER=perevozki
POSTGRES_PASSWORD=change-me
POSTGRES_DB=perevozki
# Порт Postgres на хосте (127.0.0.1). 5432 на машине разработчика часто занят другими проектами.
DB_PORT=5433
# Для backend, запущенного вне Docker. В docker-compose backend получает свой URL на db:5432.
DATABASE_URL=postgresql://perevozki:change-me@localhost:5433/perevozki?schema=public

# ---------- Backend ----------
NODE_ENV=development
PORT=3010
# Публичный origin Mini App, используется для CORS. Локально — адрес Vite.
APP_URL=http://localhost:5180
# Telegram ID владельцев (через запятую): только они вносят правки. Любой другой пользователь Telegram
# видит лишь статистику (вкладку «Аналитика»). Обязательно в production.
ADMIN_TELEGRAM_IDS=

# ---------- Telegram ----------
# Токен бота от @BotFather. Им же backend проверяет подпись initData.
# Локально можно поставить любую строку и подписывать initData скриптом scripts/dev-init-data.mjs.
BOT_TOKEN=
# HTTPS-адрес, который открывает кнопка бота (в production обычно совпадает с APP_URL).
WEBAPP_URL=

# ---------- Frontend ----------
# База API, вшивается в сборку фронтенда. "/api" = тот же домен (nginx проксирует на backend).
API_URL=/api

# ---------- Docker ----------
# Порт на хосте (127.0.0.1), на котором nginx фронтенда отдаёт Mini App и /api.
HTTP_PORT=8080
